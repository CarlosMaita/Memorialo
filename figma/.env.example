# Backend routing mode for incremental migration
# supabase: all endpoints against Supabase function server
# laravel: routes /health, /auth, /users, /providers, /services, /contracts, /bookings, /events, /billing, /admin, /upload-image, /reviews to Laravel; rest keep using Supabase
VITE_BACKEND_MODE=supabase

# Supabase function server base URL (without trailing slash)
VITE_API_BASE_URL=https://lpoybvmalhxlomsrssgm.supabase.co/functions/v1/make-server-5d78aefb

# Laravel API base URL (without trailing slash)
# Used by the Vite client bundle at build time.
VITE_LARAVEL_API_BASE_URL=http://127.0.0.1:8000/api

# Server-side (Vercel Edge Middleware) API base URL.
# Must be set as a runtime environment variable in Vercel so the edge middleware
# can fetch service data to inject per-service OG meta tags for social sharing.
# Typically the same value as VITE_LARAVEL_API_BASE_URL but resolved as a
# server-side secret so it is available at request time (not just build time).
LARAVEL_API_BASE_URL=http://127.0.0.1:8000/api

# Reverb / Echo websocket client config
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Force noindex/nofollow robots meta on every page when set to true
VITE_NOINDEXE=false
